{
  "redirects": [
    {
      "source": "/pages/privacy-policy",
      "destination": "/privacy-policy",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/descargar",
      "destination": "/api/descargar?variant=untracked"
    },
    {
      "source": "/descargar/:variant(personal-a|personal-b|pagina-a|pagina-b)",
      "destination": "/api/descargar?variant=:variant"
    },
    {
      "source": "/privacy-policy",
      "destination": "/pages/privacy-policy/index.html"
    },
    {
      "source": "/delete-account",
      "destination": "/pages/delete-account/index.html"
    },
    {
      "source": "/terms",
      "destination": "/pages/terms/index.html"
    },
    {
      "source": "/support",
      "destination": "/pages/support/index.html"
    }
  ]
}
